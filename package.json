{
  "name": "localbot",
  "version": "0.1.0",
  "private": true,
  "description": "A modular local-first Discord bot with multi-source Music playback.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "native:dev": "npm --prefix native run tauri dev",
    "native:build": "npm --prefix native run tauri build",
    "native:smoke": "node scripts/smoke-native-installer.mjs",
    "native:smoke:configured": "node scripts/smoke-native-installer.mjs --configured",
    "native:smoke:music": "node scripts/smoke-native-installer.mjs --configured --music",
    "native:smoke:soundcloud": "node scripts/smoke-native-installer.mjs --configured --soundcloud",
    "native:smoke:recovery": "node scripts/smoke-native-installer.mjs --configured --recovery",
    "native:smoke:restart": "node scripts/smoke-native-installer.mjs --configured --restart",
    "native:smoke:commands": "node scripts/smoke-native-installer.mjs --configured --commands",
    "native:smoke:crash": "node scripts/smoke-native-installer.mjs --configured --crash",
    "native:smoke:crash-recovery": "node scripts/smoke-native-installer.mjs --configured --crash-recovery",
    "native:smoke:isolated": "node scripts/smoke-native-installer.mjs --configured --dependency-isolated",
    "native:smoke:music:isolated": "node scripts/smoke-native-installer.mjs --configured --music --dependency-isolated",
    "native:verify": "node scripts/verify-native-artifact.mjs",
    "native:typecheck": "npm --prefix native run typecheck",
    "native:test": "npm --prefix native run test",
    "qa:live": "node scripts/live-readonly-qa.mjs",
    "qa:headless": "node --import tsx scripts/verify-headless-runtime.mjs",
    "audit:static": "node scripts/audit-static-production.mjs",
    "audit:docs": "node scripts/audit-docs-contract.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "register": "tsx src/register-commands.ts",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

# Required Discord application values
DISCORD_TOKEN=your-bot-token
# Compatibility alias accepted by the runtime when DISCORD_TOKEN is empty.
BOT_TOKEN=
DISCORD_CLIENT_ID=your-application-id

# Recommended for development: commands appear almost immediately in this guild.
# Leave empty to register commands globally (global updates can take time).
DISCORD_GUILD_ID=your-development-guild-id

# Optional YouTube settings
YOUTUBE_LANGUAGE=vi
YOUTUBE_LOCATION=VN
YOUTUBE_CACHE_DIR=.cache/youtube

# Optional SoundCloud official API credentials for public search/playback.
# Keep these server-side; do not expose them to a native/web client.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional local JSON location for guild playlists.
LOCALBOT_PLAYLISTS_FILE=data/playlists.json

# Optional local JSON location for per-guild Music command permissions.
LOCALBOT_MUSIC_PERMISSIONS_FILE=data/music-permissions.json

# Optional local JSON location for per-guild Equalizer settings.
LOCALBOT_EQUALIZER_FILE=data/equalizer.json

# Optional local JSON location and message XP cooldown for Community.
LOCALBOT_COMMUNITY_FILE=data/community.json
LOCALBOT_AUTOMOD_REVIEW_FILE=data/automod-review.json
LOCALBOT_XP_COOLDOWN_SECONDS=60
LOCALBOT_AUDIT_FILE=data/audit-log.json

# Privileged Discord intents. Enable the matching capability in the Discord Developer Portal first.
# Members Intent powers Welcome/Goodbye and member-join telemetry.
LOCALBOT_GUILD_MEMBERS_INTENT=false
# Message Content Intent powers content-based AutoMod; disabled means those rules are a safe no-op.
LOCALBOT_MESSAGE_CONTENT_INTENT=false

# Optional local Ollama defaults. Ollama remains disabled until enabled in native Settings.
LOCALBOT_OLLAMA_FILE=data/ollama.json
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional native control plane. The runtime contract is fixed to loopback 127.0.0.1:2901.
# Other host/port values are rejected so the unauthenticated local API cannot leave the machine.
LOCALBOT_CONTROL_ENABLED=false
LOCALBOT_CONTROL_HOST=127.0.0.1
LOCALBOT_CONTROL_PORT=2901

# Runtime profile: native (Tauri-owned Windows), headless (Node-only with optional
# loopback control), or slash-only (Node-only Discord slash commands; no listener).
# Native overrides this through the Tauri-owned child process environment.
LOCALBOT_RUNTIME_PROFILE=headless
# Leave empty to use the profile default: enabled except for slash-only.
LOCALBOT_AUTO_REGISTER_COMMANDS=

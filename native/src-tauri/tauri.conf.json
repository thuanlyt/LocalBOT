{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalBot",
  "version": "0.1.0-alpha.1",
  "identifier": "com.localbot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix .. run build && npm run build && npm run prepare:runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalBot · Native Music Console",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "0.1.0.1"
      }
    },
    "resources": {
      "resources/runtime": "runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
